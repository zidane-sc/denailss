# Supabase — project credentials (https://supabase.com/dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key (server-only, untuk upload Storage & signed URLs)
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for Drizzle (ex: postgresql://user:pass@host:5432/postgres)
DATABASE_URL=

# Site URL — dipakai untuk OAuth redirect & metadata canonical
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google OAuth dikonfigurasi di Supabase Dashboard (Auth → Providers),
# bukan di file ini.
